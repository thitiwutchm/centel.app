{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Always revalidate the shell and service worker so installed apps pick up updates.
	@nocache path */ */index.html */sw.js */manifest.webmanifest
	header @nocache Cache-Control "no-cache"
	@manifest path */manifest.webmanifest
	header @manifest Content-Type application/manifest+json
	@static path /icons/* /themeb/fonts/*
	header @static Cache-Control "public, max-age=604800"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# The API runs as its own Railway service; reach it over private networking.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api.railway.internal:8080}
	}

	handle {
		file_server {
			hide Caddyfile Dockerfile railway.json .dockerignore server
		}
	}
}
