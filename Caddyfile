{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Always revalidate the shell and service worker so installed apps pick up updates.
	@nocache path / /index.html /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type application/manifest+json
	header /icons/* Cache-Control "public, max-age=604800"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	file_server
}
